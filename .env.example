# Generate a private .env with: python3 scripts/init-env.py
# Never commit .env. Keep DJANGO_SECRET_KEY with backups: mail passwords depend on it.
DJANGO_SECRET_KEY=replace-with-a-random-secret
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=accountant
POSTGRES_USER=accountant
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
# Must not exceed the pinned ClamAV/parser ceiling of 25 MiB.
MAX_FILE_BYTES=26214400
# Counts all distinct original/context sources, including unchanged predecessors.
MAX_PACKAGE_BYTES=268435456
MAX_PACKAGE_SOURCE_FILES=10000
# Derived bank data budgets apply to previews and packages; never truncate movements.
MAX_WORKBOOK_BANK_ROWS=10000
MAX_WORKBOOK_BANK_BYTES=16777216
# Local ClamAV only; Compose fixes host/port internally (no published port).
# Freshclam checks hourly; fail closed if loaded signatures are >48 hours old.
CLAMAV_MAX_SIGNATURE_AGE=172800
CLAMAV_TIMEOUT=60
# Publishes the UI/API/MCP port on the Docker host. Use 127.0.0.1 for local-only access.
# Local build image tag; changing this does not pull or rebuild an image automatically.
APP_VERSION=0.1.1
HTTP_BIND=0.0.0.0
HTTP_PORT=8000
# Add the actual internal server IP/hostname to the host/origin allowlists below.
ALLOWED_HOSTS=localhost,127.0.0.1,app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,app:8000
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://app:8000
# Optional synthetic companies/accounts/categories (no mail access, no automatic dispatch):
BOOTSTRAP_DEMO=0
